# Copie este arquivo para ".env" (sem o .example) e preencha com os
# dados reais do seu cluster HiveMQ Cloud. O .env de verdade fica
# listado no .gitignore e nunca sobe para o repositorio.
#
# IMPORTANTE: variaveis expostas ao navegador pelo Vite PRECISAM
# comecar com o prefixo VITE_ - e o unico jeito do Vite saber que
# essa variavel deve ser incluida no codigo final enviado ao cliente.

VITE_MQTT_HOST=xxxxx.s1.eu.hivemq.cloud
VITE_MQTT_PORT=8884
VITE_MQTT_USERNAME=seu_usuario_hivemq
VITE_MQTT_PASSWORD=sua_senha_hivemq
VITE_MQTT_TOPIC=calculadora_agricola/leituras
