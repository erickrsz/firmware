# Copie este arquivo para ".env" (sem o .example) e preencha com os
# dados reais. O .env de verdade fica listado no .gitignore e nunca
# sobe para o repositorio.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calculadora_agricola
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres

# --- MQTT (HiveMQ Cloud) ---
# Mesmo cluster que ja esta configurado no firmware e no dashboard.
# Atencao: aqui a porta e 8883 (TCP+TLS), diferente da 8884 usada
# pelo dashboard no navegador (WebSocket).
MQTT_HOST=xxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=seu_usuario_hivemq
MQTT_PASSWORD=sua_senha_hivemq
MQTT_TOPIC=calculadora_agricola/leituras
