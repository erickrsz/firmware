#pragma once

// ---------- Identificacao deste no ----------
// Cada ESP32 fisico precisa de um NODE_ID diferente. IS_ROOT_NODE deve
// ser "true" em APENAS UM dispositivo (o que fica perto do roteador e
// faz a ponte com o Wi-Fi/MQTT). Todos os outros ficam com "false" e
// so participam da rede mesh.
#define NODE_ID       "esp32_no_sensor_01"
#define IS_ROOT_NODE  true

// ---------- Rede Mesh ----------
// Mesma configuracao em TODOS os nos (raiz e sensores). A senha
// precisa ter pelo menos 8 caracteres.
#define MESH_PREFIX   "calculadora_agricola_mesh"
#define MESH_PASSWORD "senha_do_mesh_min8car"
#define MESH_PORT     5555

// ---------- Wi-Fi ----------
// So e realmente usado pelo no raiz (IS_ROOT_NODE = true) - e por
// onde ele se conecta a internet para falar com o broker MQTT.
#define WIFI_SSID     "SEU_WIFI"
#define WIFI_PASSWORD "SUA_SENHA"

// ---------- MQTT (HiveMQ Cloud) ----------
// So e usado pelo no raiz.
#define MQTT_BROKER    "xxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT      8883
#define MQTT_USERNAME  "seu_usuario_hivemq"
#define MQTT_PASSWORD  "sua_senha_hivemq"
#define MQTT_TOPIC     "calculadora_agricola/leituras"
#define MQTT_CLIENT_ID "esp32_raiz_mqtt"

// ---------- Sensor ----------
#define DHTPIN  4
#define DHTTYPE DHT22

// ---------- Timing ----------
#define READ_INTERVAL_MS 8000UL

// ---------- NTP (hora real, so usado pelo no raiz) ----------
#define NTP_SERVER     "pool.ntp.org"
#define GMT_OFFSET_SEC -10800
#define DAYLIGHT_OFFSET_SEC 0
