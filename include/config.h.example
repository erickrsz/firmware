#pragma once

// ---------- Wi-Fi ----------
// Copie este arquivo para "config.h" (sem o .example) e preencha com
// os seus dados reais. O config.h de verdade fica listado no .gitignore
// e nunca sobe para o repositorio.
#define WIFI_SSID     "SEU_WIFI"
#define WIFI_PASSWORD "SUA_SENHA"

// ---------- MQTT ----------
#define MQTT_BROKER    "test.mosquitto.org"
#define MQTT_PORT      1883
#define MQTT_TOPIC     "calculadora_agricola/leituras"
#define MQTT_CLIENT_ID "esp32_no_sensor_01"

// ---------- Sensor ----------
#define DHTPIN  4
#define DHTTYPE DHT22

// ---------- Timing ----------
// 30 minutos, conforme metodologia do TCC (intervalo fixo de amostragem)
#define READ_INTERVAL_MS 180000UL // 30 minutos

// ---------- NTP (hora real) ----------
#define NTP_SERVER     "pool.ntp.org"
#define GMT_OFFSET_SEC -10800   // UTC-3 (horário de Brasília, sem horário de verão)
#define DAYLIGHT_OFFSET_SEC 0